# Database
DATABASE_URL="postgresql://username:password@localhost:5432/solo_energy_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# App Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Base publica do app — raiz dos links enviados por e-mail.
# Em producao precisa ser a URL que o usuario acessa (ex: https://app.soloenergia.com.br),
# senao o convite de pagador (/convite/<token>) aponta para o host interno.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail (reset de senha + convite e cobranca da Geracao Distribuida)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Solo Energia <noreply@soloenergia.com.br>"

# Optional: External API Keys
SOLIS_API_KEY="your-solis-api-key"
SOLPLANET_API_KEY="your-solplanet-api-key"
GROWATT_API_KEY="your-growatt-api-key"

# Admin Inverter Provider Accounts
SOLIS_ADMIN_API_URL="https://api.soliscloud.com"
SOLIS_ADMIN_API_KEY="your-solis-admin-api-key"
SOLIS_ADMIN_API_SECRET="your-solis-admin-api-secret"

SOLPLANET_ADMIN_API_URL="https://internation-cloud.solplanet.net"
SOLPLANET_ADMIN_ACCOUNT="your-solplanet-admin-account"
SOLPLANET_ADMIN_PASSWORD="your-solplanet-admin-password"

# Next Auth (Obrigatório para login)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="199595"

JESTOR_CREATE_LEAD_WEBHOOK_URL="https://mateussmaia.api.jestor.com/webhook/ZjNkNDE0NGZlOTY2YzE5ee4dccd038MTc2Mjk1MDI4OTdlYjA2"

# AUXSOL / Nansen Inverter Integration
AUXSOL_BASE_URL="https://eu.auxsolcloud.com/auxsol-api"
AUXSOL_APP_ID="your-auxsol-app-id"
AUXSOL_APP_SECRET="your-auxsol-app-secret"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"

# Bill Analyzer (provider-agnostic)
ANTHROPIC_API_KEY=
BILL_ANALYZER_PROVIDER=claude
BILL_ANALYZER_CLAUDE_MODEL=claude-sonnet-4-6
BILL_ANALYZER_OPENAI_MODEL=gpt-4o

# Object Storage for Energy Bill PDFs (MinIO/S3-compatible)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET_NAME="uploads"
MINIO_USE_SSL=false
MINIO_REGION="us-east-1"
