# Exemplo de variáveis de ambiente para Docker
# Copie este arquivo para .env antes de rodar docker-compose

# DATABASE
DATABASE_URL="postgres://postgres:postgres@postgres:5432/solo-energia"
DATABASE_NAME="solo-energia"
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_HOST=postgres

# AUTH
JWT_SECRET="secret"

# NEXT
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL publica do app usada nos links de e-mail/WhatsApp (nunca um host interno)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# REDIS
REDIS_URL="redis://redis:6379"

# EMAIL (usar mailhog para dev ou SMTP real para prod)
SMTP_HOST="mailhog"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Solo Energy <noreply@solo-energia.com>"

# WHATSAPP
WHATSAPP_PROVIDER="evolution"
WHATSAPP_EVOLUTION_URL=""
WHATSAPP_EVOLUTION_API_KEY=""
WHATSAPP_EVOLUTION_INSTANCE=""

# API
API_BASE_URL="http://app:3000"
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_SECRET_KEY="sk_zents_test"

# PAYMENT
PAYMENT_PROVIDER="stripe"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_FREE_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# MINIO
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET_NAME="uploads"
MINIO_USE_SSL=false

# JOBS
JOB_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3
JOB_DEFAULT_TIMEOUT=30000
JOB_CLEANUP_INTERVAL=3600000
JOB_ENABLE_METRICS=true

# Faturapi (busca mensal da fatura de energia) — apenas no servidor
FATURAPI_KEY="fp_live_your-key"
FATURAPI_WEBHOOK_SECRET="your-webhook-secret"

# Analise da fatura por IA (resumo, nota, alertas e recomendacoes).
# Sem BILL_ANALYZER_PROVIDER o padrao e "claude", que exige ANTHROPIC_API_KEY.
# "gemini" usa GEMINI_API_KEY. "openai" NAO le faturas (so o chat de suporte usa OpenAI).
BILL_ANALYZER_PROVIDER=claude
ANTHROPIC_API_KEY=
BILL_ANALYZER_CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
OPENAI_API_KEY=

# Sincronizacao automatica dos inversores. Sem esta variavel o sync em segundo plano
# nao roda: a geracao so atualiza quando alguem abre a tela.
GENERATION_SYNC_INTERVAL_MINUTES=15
# Opcional: token para um cron externo chamar POST /api/generation/sync (header x-sync-token)
GENERATION_SYNC_TOKEN=

# Criptografia das credenciais dos inversores (>= 32 caracteres). Sem ela usa o JWT_SECRET.
APP_ENCRYPTION_KEY=

# Notificacoes inteligentes (vencimento, nova fatura, pagamento, economia, falta de geracao).
# Job diario as NOTIFICATIONS_HOUR (horario de Fortaleza). "false" desliga o agendamento
# em processo; POST /api/notifications/run (header x-sync-token = GENERATION_SYNC_TOKEN)
# dispara o mesmo job por um cron externo. Os links usam NEXT_PUBLIC_BASE_URL.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_HOUR=9
# E-mails (separados por virgula) que recebem alertas criticos: inversor sem geracao, senha da Enel invalida.
ADMIN_ALERT_EMAIL=
# WhatsApp via Evolution API (opcional). Sem estas variaveis o WhatsApp e ignorado.
WHATSAPP_PROVIDER=evolution
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCE=
